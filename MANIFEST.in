include LICENSE README.md CHANGELOG.md CONTRIBUTING.md SECURITY.md AGENTS.md .gitignore
include flake.nix flake.lock
recursive-include nix *.nix
recursive-include docs *.md
recursive-include skills *.md *.yaml
recursive-include examples *.md *.py *.toml
recursive-include scripts *.py *.sh
recursive-include tests *.py
recursive-include .github *.yml
exclude **/*.pyc
